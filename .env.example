# Copy to .env and replace every placeholder with private values.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=exa
DB_USER=exa
DB_PASSWORD=replace-with-a-unique-database-password
DB_ROOT_PASSWORD=replace-with-a-different-unique-root-password
JWT_SECRET=replace-with-at-least-64-random-hex-characters
GEMINI_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Cloudflare Pages build environment variable (set in the Cloudflare dashboard):
# VITE_API_URL=https://your-backend.example.com/api
# Firebase Web app settings (set these as Cloudflare Pages build variables):
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=

# Firebase Admin SDK (set only on the backend/Railway service):
# FIREBASE_PROJECT_ID=
# Prefer platform Application Default Credentials over this JSON variable.
# If required, set FIREBASE_SERVICE_ACCOUNT_JSON to the complete service account JSON.